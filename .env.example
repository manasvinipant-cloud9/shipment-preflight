############################################################################
#  SHIPMENT PRE-FLIGHT: keys and config. Copy to .env.local for local development,
#  or add each value under Vercel → Project → Settings → Environment Variables.
#  .env* files are git-ignored. Never commit real keys.
############################################################################

# ---- GEMINI (server only; powers plain-English chat) ----
# Without a key the chat falls back to the offline parser and the app says so. Batch upload never needs a key.
GEMINI_API_KEY=
# Optional. Defaults shown. The fallbacks are tried in order when the primary is out of quota / overloaded / retired.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
